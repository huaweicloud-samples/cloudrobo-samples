<?xml version="1.0" encoding="utf-8"?>
<robot name="umi">
	<link name="hand_link">
		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="1.0"/>
			<inertia ixx="0.001" ixy="0.0" ixz="-0.0" iyy="0.001" iyz="-0.0" izz="0.001"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://ur5e_description/meshes/gripper_realsense/hand.dae"/>
			</geometry>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://ur5e_description/meshes/gripper_realsense/hand.STL"/>
			</geometry>
		</collision>
	</link>

	<link name="left_finger_link">
		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.1"/>
			<inertia ixx="0.0001" ixy="0.0" ixz="-0.0" iyy="0.0001" iyz="-0.0" izz="0.0001"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://ur5e_description/meshes/left_finger.dae"/>
			</geometry>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://ur5e_description/meshes/left_finger.STL"/>
			</geometry>
		</collision>
	</link>

	<link name="right_finger_link">
		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.1"/>
			<inertia ixx="0.0001" ixy="0.0" ixz="-0.0" iyy="0.0001" iyz="-0.0" izz="0.0001"/>
